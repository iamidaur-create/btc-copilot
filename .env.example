# ================================================================
# BTC COPILOT — ENVIRONMENT CONFIGURATION TEMPLATE
# ================================================================
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# IMPORTANT:
# - NEVER commit `.env.local` to Git.
# - NEVER store real private keys or seed phrases in environment variables.
# ================================================================

# --- AI PROVIDER (Google Gemini) ---
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# --- BLOCKCHAIN EXPLORER API (Mempool.space) ---
# Free public API — No API key required
NEXT_PUBLIC_MEMPOOL_API_URL=https://mempool.space/api
NEXT_PUBLIC_MEMPOOL_LN_API_URL=https://mempool.space/api/v1/lightning

# --- DEMONSTRATION DEFAULTS ---
# Satoshi Nakamoto Genesis Block Address (Block 0, 2009)
NEXT_PUBLIC_DEMO_WALLET_ADDRESS=1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa

